[Unit]
Description=Publish completed MEDTRACK ciphertext sets to the read-only NAS export
After=local-fs.target
ConditionPathIsDirectory=/srv/medtrack/offsite-backups/local

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/usr/local/sbin/medtrack-export-encrypted-backups
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
# One common bind mount is required: two separate ReadWritePaths mounts make
# link(2) return EXDEV even when both directories use the same ext4 filesystem.
ReadWritePaths=/srv/medtrack
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
