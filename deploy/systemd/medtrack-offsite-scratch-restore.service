[Unit]
Description=Independently scratch-restore a MEDTRACK encrypted off-site backup
Documentation=file:///srv/medtrack/app/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/medtrack/app
Environment=MEDTRACK_BACKUP_CONFIG=/etc/medtrack-backup/backup.env
ExecStart=/srv/medtrack/app/scripts/run-offsite-scratch-restore.sh
UMask=0077
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/medtrack-backup-health
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
