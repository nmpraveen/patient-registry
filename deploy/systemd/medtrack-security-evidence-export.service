[Unit]
Description=Export PHI-safe MEDTRACK audit and request security evidence
Documentation=file:///srv/medtrack/app/RUNBOOK.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/medtrack/app
Environment=MEDTRACK_BACKUP_CONFIG=/etc/medtrack-backup/backup.env
ExecStart=/srv/medtrack/app/scripts/export-security-evidence.sh
UMask=0077
TimeoutStartSec=30m
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/medtrack/app /etc/medtrack-backup /srv/medtrack/security-logs
ReadWritePaths=/srv/medtrack/security-evidence
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
