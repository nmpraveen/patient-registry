SECRET_KEY=change-me-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=
MEDTRACK_DOMAIN=
BACKUP_HOST_DIR=./backups

# Enable these in production behind HTTPS.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
SESSION_TIMEOUT_SECONDS=43200
SESSION_SAVE_EVERY_REQUEST=True
CSRF_COOKIE_SECURE=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_PROTO=False
DEVICE_APPROVAL_TRUST_COOKIE_NAME=medtrack_trusted_device
DEVICE_APPROVAL_TRUST_COOKIE_AGE=315360000
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=MEDTRACK
WEBAUTHN_ALLOWED_ORIGINS=

# Shared database-backed throttling for website, admin, and JWT authentication.
AUTH_THROTTLE_ACCOUNT_LIMIT=5
AUTH_THROTTLE_IP_LIMIT=30
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_BLOCK_SECONDS=900

# Optional Android companion push notifications. Leave disabled unless Firebase
# service-account credentials are installed on the server.
FCM_ENABLED=False
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=

POSTGRES_DB=patient_registry
POSTGRES_USER=patient_registry
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
