# Installed as /etc/medtrack-backup/backup.env with mode 0600.
# This file contains paths and remote names only. Never put OAuth tokens here.

MEDTRACK_REPO_ROOT=/srv/medtrack/app
MEDTRACK_ENV_FILE=/srv/medtrack/app/.env
MEDTRACK_OFFSITE_ROOT=/srv/medtrack/offsite-backups
MEDTRACK_BACKUP_STATE_ROOT=/srv/medtrack/offsite-backups/state
RCLONE_CONFIG=/srv/medtrack/backup-secrets/rclone.conf
RCLONE_REMOTE=medtrack-drive:Naveen-Hospital-Backups/MEDTRACK/production
AGE_RECIPIENT_FILE=/srv/medtrack/backup-secrets/age-recipient.txt
MEDTRACK_SECURITY_LOG_DIR=/srv/medtrack/security-logs
MEDTRACK_SECURITY_EVIDENCE_ROOT=/srv/medtrack/security-evidence
MEDTRACK_SECURITY_EVIDENCE_ALERT_HOOK=/absolute/path/to/alert-hook
MEDTRACK_SECURITY_EVIDENCE_HEALTH_HOOK=/srv/medtrack/app/scripts/verify-security-evidence.sh
MEDTRACK_SECURITY_EVIDENCE_MAX_AGE_SECONDS=7200
MEDTRACK_SECURITY_EVIDENCE_MAX_LAG_SECONDS=7200
MEDTRACK_SECURITY_EVIDENCE_KEEP_SEGMENTS=2160
MEDTRACK_AUDIT_EXPORT_MAX_ROWS=10000
MEDTRACK_SECURITY_LOG_EXPORT_MAX_BYTES=1048576
MEDTRACK_SECURITY_FAILURE_ALERT_THRESHOLD=25
MEDTRACK_REQUIRE_AUDIT_EVENT_SCHEMA=1

# Production health stream-hashes every retained ciphertext. Do not weaken this
# on the independent verifier.
MEDTRACK_HEALTH_PRODUCTION_MODE=1
MEDTRACK_HEALTH_HASH_MODE=all

# Configure these only on an independent scratch-restore verifier that holds
# an offline identity. Never copy the private age identity to the VPS or NAS.
MEDTRACK_SCRATCH_RESTORE_HOOK=/absolute/path/to/scratch-restore-hook
MEDTRACK_SCRATCH_RESTORE_ALERT_HOOK=/absolute/path/to/alert-hook
MEDTRACK_SCRATCH_RESTORE_RECEIPT=/var/lib/medtrack-backup-health/scratch-restore.receipt
MEDTRACK_SCRATCH_RESTORE_MAX_AGE_SECONDS=691200
